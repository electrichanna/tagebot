# tagebot configuration. Copy to .env and fill in.
# Every setting is TAGEBOT_<SECTION>__<KEY> (two underscores between section and key).
# Lines that are commented out show the default.
#
# Secrets are not written in this file. Any variable can be read from a file by adding _FILE to its
# name; passwords and API keys are files in the secrets/ folder. The paths here are for running
# without Docker; docker-compose.yml mounts the same files as Docker secrets and sets the paths itself.
# Settings changed in chat (/params, /vocab, /model, /temp, /schedule) are saved in settings.json
# on the SMB share and override the values here.

# Time zone for the daily check-in
TZ=Europe/Berlin

# ---- Signal (signal-cli-rest-api) -------------------------------------------------
# Number registered with signal-cli-rest-api (international format)
TAGEBOT_SIGNAL__PHONE_NUMBER=+491234567890
# Your own number: the only one the bot answers and sends the check-in to
TAGEBOT_SIGNAL__OWNER_NUMBER=+491701234567
# Address of signal-cli-rest-api; use signal-api:8080 with the bundled one in docker-compose.yml.
# It must run in json-rpc mode (MODE=json-rpc), otherwise the bot receives no messages.
TAGEBOT_SIGNAL__API_URL=signal-api:8080
# https_only, http_only or auto (tries HTTPS/WSS first, falls back to HTTP/WS)
# TAGEBOT_SIGNAL__CONNECTION_MODE=auto

# ---- Language model (Ollama or any OpenAI-compatible API) ------------------------
# Base URL including the port; /v1 is added automatically
TAGEBOT_LLM__URL=http://192.168.0.170:11434
# TAGEBOT_LLM__MODEL=ministral-3:8b
# Chat temperature (0-2); change later with /temp
# TAGEBOT_LLM__TEMPERATURE=0
# API key file, only if your endpoint needs one (Ollama does not). For Docker also add the
# llm_api_key secret to docker-compose.yml, like smb_password
# TAGEBOT_LLM__API_KEY_FILE=secrets/llm_api_key
# Optional extra text appended to the chat system prompt
# TAGEBOT_LLM__ADD_SYSTEM_PROMPT=

# ---- Speech-to-text ---------------------------------------------------------------
# speaches: OpenAI-compatible Speaches server, /vocab terms are sent with every request
# wyoming:  Wyoming faster-whisper server, /vocab only works via --initial-prompt + server restart
TAGEBOT_ASR__BACKEND=speaches
# Force a language (de, en); empty = auto-detect (unreliable on short clips)
# TAGEBOT_ASR__LANGUAGE=

# Speaches (only for ASR__BACKEND=speaches): base URL including the port, /v1 is added automatically
TAGEBOT_SPEACHES__URL=http://192.168.0.170:8000
# Model id as Speaches knows it (download it on the server first)
# TAGEBOT_SPEACHES__MODEL=Systran/faster-whisper-large-v3
# API key file, only if your Speaches server needs one. For Docker also add the
# speaches_api_key secret to docker-compose.yml, like smb_password
# TAGEBOT_SPEACHES__API_KEY_FILE=secrets/speaches_api_key

# Wyoming (only for ASR__BACKEND=wyoming): host without protocol
# TAGEBOT_WYOMING__HOST=192.168.0.170
# TAGEBOT_WYOMING__PORT=10300

# ---- Diary --------------------------------------------------------------------------
# Default check-in time (24h); change later with /schedule
# TAGEBOT_DIARY__REMINDER_TIME=21:00
# Default parameters, comma-separated; change later with /params add and /params remove
# TAGEBOT_DIARY__PARAMETERS=mood, pain, energy, sleep

# ---- SMB share (where the diary is stored) -------------------------------------------
TAGEBOT_SMB__SERVER=nas.local
TAGEBOT_SMB__SHARE=diary
# Folder inside the share; files go to <base_dir>/<YYYY>/<YYYY-MM-DD>/
TAGEBOT_SMB__BASE_DIR=tagebot
TAGEBOT_SMB__USERNAME=diary_user
# File with the SMB password (in Docker: the smb_password secret)
TAGEBOT_SMB__PASSWORD_FILE=secrets/smb_password
# TAGEBOT_SMB__PORT=445
